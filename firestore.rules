rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    function acceptedInvite(id) {
      return exists(/databases/$(database)/documents/invites/$(id))
        && get(/databases/$(database)/documents/invites/$(id)).data.status == 'accepted';
    }

    // Perfis são visíveis para quem está logado; cada pessoa edita só o próprio.
    match /profiles/{uid} {
      allow read: if signedIn();
      allow write: if signedIn() && request.auth.uid == uid;

      // Contato opcional: só o dono e quem tem um convite aceito com ele podem ler.
      match /private/{doc} {
        allow read: if signedIn() && (
          request.auth.uid == uid
          || acceptedInvite(uid + '_' + request.auth.uid)
          || acceptedInvite(request.auth.uid + '_' + uid)
        );
        allow write: if signedIn() && request.auth.uid == uid;
      }
    }

    // Convite de café. O id é sempre "<quem convidou>_<quem foi convidado>".
    match /invites/{id} {
      allow read: if signedIn() && request.auth.uid in resource.data.participants;

      allow create: if signedIn()
        && request.resource.data.from == request.auth.uid
        && request.resource.data.to != request.auth.uid
        && request.resource.data.participants == [request.resource.data.from, request.resource.data.to]
        && request.resource.data.status == 'pending'
        && id == request.resource.data.from + '_' + request.resource.data.to
        && request.resource.data.message.size() <= 200;

      // Só quem recebeu responde, e só muda o status.
      allow update: if signedIn()
        && request.auth.uid == resource.data.to
        && resource.data.status == 'pending'
        && request.resource.data.status in ['accepted', 'declined']
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'respondedAt']);

      // Chat: liberado só entre os dois, depois do aceite.
      match /messages/{messageId} {
        allow read: if signedIn()
          && acceptedInvite(id)
          && request.auth.uid in get(/databases/$(database)/documents/invites/$(id)).data.participants;

        allow create: if signedIn()
          && acceptedInvite(id)
          && request.auth.uid in get(/databases/$(database)/documents/invites/$(id)).data.participants
          && request.resource.data.senderUid == request.auth.uid
          && request.resource.data.text is string
          && request.resource.data.text.size() > 0
          && request.resource.data.text.size() <= 500;
      }
    }
  }
}
