# Copie para .env.local e preencha (Firebase Console > Project settings > Your apps > Web)
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# Chave do Gemini (https://aistudio.google.com/apikey). Fica só no servidor.
GEMINI_API_KEY=
# Opcional
GEMINI_MODEL=gemini-3.8-flash
